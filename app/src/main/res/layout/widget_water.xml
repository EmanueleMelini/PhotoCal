<?xml version="1.0" encoding="utf-8"?>
<!-- Water widget (RemoteViews: only framework layouts and views, so android:tint and no
     AppCompat). Texts and descriptions are set by WaterWidget in the app language; the ones
     here are for the preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="UseAppTint,NestedWeights,UseCompoundDrawables">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/water_remove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_button_round"
            android:contentDescription="@string/water_remove_glass"
            android:src="@drawable/ic_remove"
            android:tint="@color/widget_on_primary" />

        <LinearLayout
            android:id="@+id/water_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/water_count"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:autoSizeMaxTextSize="28sp"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/widget_water_preview_count"
                android:textColor="@color/widget_on_surface"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_water_drop"
                    android:tint="@color/widget_primary" />

                <TextView
                    android:id="@+id/water_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:text="@string/water_title"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/water_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_button_round"
            android:contentDescription="@string/water_add_glass"
            android:src="@drawable/ic_add"
            android:tint="@color/widget_on_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Hidden until a bottle is set in the profile -->
        <ImageButton
            android:id="@+id/water_bottle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_pill_primary"
            android:contentDescription="@string/water_add_bottle"
            android:src="@drawable/ic_water_bottle"
            android:tint="@color/widget_on_primary" />

        <ImageButton
            android:id="@+id/food_photo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_pill"
            android:contentDescription="@string/widget_add_photo"
            android:src="@drawable/ic_photo_camera"
            android:tint="@color/widget_on_secondary_container" />

        <ImageButton
            android:id="@+id/food_manual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_pill"
            android:contentDescription="@string/widget_add_manual"
            android:src="@drawable/ic_add"
            android:tint="@color/widget_on_secondary_container" />
    </LinearLayout>
</LinearLayout>
